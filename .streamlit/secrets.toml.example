# .streamlit/secrets.toml.example
# Pune Traffic Complaint Intelligence operates entirely on local bundled datasets
# and local models (spaCy + scikit-learn). No external API secrets are required.
# If integrating future external APIs (e.g. Mapbox, OpenStreetMap, or LLM providers),
# configure them here:
# MAPBOX_API_KEY = "your_mapbox_api_key_here"
# EXTERNAL_SERVICES_ENABLED = false
